# --- Database ---
# Local dev with zero setup uses SQLite. For Postgres (docker-compose), use:
# DATABASE_URL=postgresql+psycopg2://docutrack:docutrack@db:5432/docutrack
DATABASE_URL=sqlite:///./docutrack.db

# --- Auth / JWT ---
# CHANGE THIS in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Bootstrap admin (created by scripts/seed.py) ---
FIRST_ADMIN_EMAIL=admin@docutrack.local
FIRST_ADMIN_PASSWORD=ChangeMe!123

# --- Attachments (local disk) ---
ATTACHMENT_DIR=./storage/attachments
MAX_UPLOAD_MB=10

# --- Import/export scratch dir ---
JOB_DIR=./storage/jobs

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
